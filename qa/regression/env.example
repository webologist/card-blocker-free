# Test-only values for the regression rig. Copy to .env.local at the repo root
# (keep a backup of your real one). None of these are real credentials, and
# NEXT_PUBLIC_SUPABASE_URL points at the in-memory stand-in database
# (qa/regression/fake-supabase.js), never at a real project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon
SUPABASE_SERVICE_ROLE_KEY=test-service
OTP_MODE=dummy
OTP_SECRET=local-test-otp-secret
ADMIN_API_SECRET=local-test-admin-key
# Must be the number app.js treats as the admin (its hard-coded admin constant).
ADMIN_PHONE=+919223548779
